# Plex Configuration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# Last.fm Configuration
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud TTS Configuration
GOOGLE_CLOUD_PROJECT_ID=your_google_project_id
GOOGLE_CLOUD_CREDENTIALS_JSON=path/to/service-account-key.json

# ElevenLabs TTS Configuration (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# TTS Provider Selection
# Options: "google" or "elevenlabs"
TTS_PROVIDER=google

# News Sources Configuration
BBC_URL=https://www.bbc.com/news
GUARDIAN_API_KEY=your_guardian_api_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# Audio Configuration
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192k
